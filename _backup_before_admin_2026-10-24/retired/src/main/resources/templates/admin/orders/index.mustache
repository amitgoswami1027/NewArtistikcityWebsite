          {{#flash.success}}
<div class="alert alert-success alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.success}}</strong>
</div>
{{/flash.success}}

{{#flash.error}}
<div class="alert alert-danger alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.error}}</strong>
</div>
{{/flash.error}}

{{#flash.warning}}
<div class="alert alert-warning alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.warning}}</strong>
</div>
{{/flash.warning}}

{{#flash.info}}
<div class="alert alert-info alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.info}}</strong>
</div>
{{/flash.info}}

{{#hasErrors}}
<div class="alert alert-danger">
    <button type="button" class="close" data-dismiss="alert">×</button>
    Please check the form below for errors
</div>
{{/hasErrors}}
          
    <div class="row">

        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Manage Subscription</h4>
                    <p class="card-description"> </p>

                    <div class="bootdey">
                        <div class="panel panel-default panel-order">
                            <div class="panel-heading">
                                <strong>Order history</strong>
                                <div class="btn-group pull-right">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-default btn-xs dropdown-toggle"
                                            data-toggle="dropdown">Filter history <i class="fa fa-filter"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-right">
                                            <li><a href="#">Approved orders</a></li>
                                            <li><a href="#">Pending orders</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <hr style="border: 1px solid #ccc; clear: both;" />

                            <div class="panel-body">
                                {{#orders}}
                                <div class="row">
                                    <div class="col-md-2">
                                        {{#when}}{{user.profile_photo}}⟫
                                            <img src="/storage/uploads/students/{{user.id}}/{{user.profile_photo}}" width="50"><br />
                                        ⟪else⟫ 
                                            <img src="https://bootdey.com/img/Content/user_3.jpg" class="media-object img-thumbnail" alt="{{user.name}}" /><br />
                                        {{/when}} 
                                        <a class="btn btn-success btn-icon" href="/student/{{user.slug}}" target="_blank">VIEW PROFILE</a>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="pull-right">
                                                    <label class="label label-danger">Payment Status: {{#when}}{{payment_status}}⟫<span style="color:green;">Success</span>⟪else⟫<span style="color:red;">Failed</span>{{/when}} </label><br />
                                                    <label class="label label-danger">Certificate Issued: {{#when}}{{issue_certificate}}⟫<span style="color:green;">Yes</span>⟪else⟫<span style="color:red;">No</span>{{/when}}</label>
                                                </div>
                                                <span><strong>Order ID</strong></span> <span class="label label-info">{{order_number}}</span><br />
                                                <span><strong>Course</strong></span> <span class="label label-info">{{course.title}}</span><br />
                                                <span><strong>Price</strong></span> <span class="label label-info">
                                                    {{#when}}{{price_type}}==inr⟫
                                                        INR {{#money}}{{price}}{{/money}}
                                                    ⟪else⟫
                                                        USD {{#money}}{{price}}{{/money}}
                                                    {{/when}}
                                                </span><br />
                                                <a data-placement="top" class="btn btn-primary btn-icon" href="#orderDetailsModal" data-remote="/admin/order/details/{order_id}" data-toggle="modal" data-target="#orderDetailsModal" title="View Details">VIEW ORDER DETAILS</a>
                                                {{#when}}{{issue_certificate}}==1 && {{certificate_name}}!=⟫
