</div>
<div class="row">
	<div class="col-lg-12 grid-margin">
		<div class="card">
			<div class="card-body">
				<h5 class="card-title mb-4">Manage Tasks (<a href="/admin/tasks">View All</a>)</h5>
				<div class="fluid-container">
					{{#getMessages}}
