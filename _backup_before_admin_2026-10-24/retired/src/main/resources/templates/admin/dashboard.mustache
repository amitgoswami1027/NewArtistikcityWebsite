<script>
function confirmStatusChange(id, status) {
	console.log(status);
	swal({
		title: "Are you sure?",
		text: "You want to change the status of this reply!",
		icon: "warning",
		buttons: true,
		dangerMode: true,
	})
	.then(isConfirm => {
		if (!isConfirm) throw null;

		$.ajax({
			type: "POST",
			url: "/api/modules/lessons/task/change-status",
			headers: {
				'X-CSRF-TOKEN': $('meta[name="_token"]').attr('content')
			},
			data: "student_task_id="+id+"&status="+status,
			dataType: 'json',
			success: function(data) {}
		})
		.done(function(data) {
			swal("Status Changed!", "The status has been successfully changed!", "success");
			setTimeout(() => {
				window.location.reload();
			}, 1000);
		})
		.error(function(data) {
			swal("Oops", "We couldn't connect to the server!", "error");
		});
	})
	.catch(err => {
		if (err) {
			swal("Oops", "The request failed!", "error");
		} else {
			swal.stopLoading();
			swal.close();
		}
	});
}

$('#taskModal').on('show.bs.modal', function (event) {
	let button = $(event.relatedTarget);
	let task_id = button.data('task');
	let student_teacher_connect_id = button.data('connect');
	let user_id = button.data('student');
	console.log(task_id);
	console.log(student_teacher_connect_id);
	console.log(user_id);
	let modal = $(this)
	modal.find('.modal-title').text('Task #' + task_id + '');
	modal.find('.modal-body input#reply').val('');
	modal.find('.modal-body input#task_id').val(task_id);
	modal.find('.modal-body input#student_teacher_connect_id').val(student_teacher_connect_id);
	modal.find('.modal-body input#to_id').val(user_id);
});

$(document).ready(function () {
	$('#taskFrm').on('submit', function(e) {
		e.preventDefault();
		$.ajax({
			type: "POST",
			url: "/api/modules/lessons/task/reply",
			headers: {
				'X-CSRF-TOKEN': $('meta[name="_token"]').attr('content')
			},
			data: $('#taskFrm').serialize(),
			dataType: 'json',
			success: function (response) {
				console.log(response)
				$('#taskModal').modal('hide')
				// alert("data saved");
			},
			error: function(error) {
				console.log(error)
				// alert("Data not saved");
			}
		});
	});
});
</script>

