							<div class="col-md-1">
								{{#when}}{{profile_photo}}⟫
                      				<img src="/storage/uploads/students/{{user_id}}/{{profile_photo}}" class="img-sm rounded-circle mb-4 mb-md-0 d-block mx-md-auto">
                    			{{/when}} 
							</div>
							<div class="ticket-details col-md-9">
								<div class="d-flex">
									<p class="text-dark font-weight-semibold mr-2 mb-0 no-wrap">
										<strong>{{name}}</strong>
										{{#when}}{{review_status}}==Under Review⟫
											<span class="badge badge-primary">Under Review</span>
										⟪else⟫{{#when}}{{review_status}}==Reviewed⟫
											<span class="badge badge-info">Reviewed</span>
										⟪else⟫{{#when}}{{review_status}}==Feedback⟫
											<span class="badge badge-warning">Feedback</span>
										⟪else⟫
											<span class="badge badge-success">Completed</span>
										{{/when}}{{/when}}{{/when}}
									</p>
									
									
								</div>
								<p class="text-gray ellipsis mb-2">{{reply}}</p>
								<div class="row text-gray d-md-flex d-none">
									<div class="col-4 d-flex">
										<small class="mb-0 mr-2 text-muted text-muted">Last responded:</small>
										<small class="Last-responded mr-2 mb-0 text-muted text-muted">{{created_at}}</small>
									</div>
									<div class="col-4 d-flex">
										
										
									</div>
								</div>
							</div>
							<div class="ticket-actions col-md-2">
								<div class="btn-group dropdown">
									<button type="button"
										class="btn btn-success dropdown-toggle btn-sm"
										data-toggle="dropdown" aria-haspopup="true"
										aria-expanded="false"> Manage </button>
									<div class="dropdown-menu">
										<a class="dropdown-item" data-toggle="modal"
											data-target="#taskModal"
											data-task="{{task_id}}"
											data-connect={{student_teacher_connect_id}}
											data-student={{user_id}}><i
												class="fa fa-reply fa-fw"></i>Quick reply</a>
										<div class="dropdown-divider"></div>
										<span class="dropdown-item"><i
												class="fa fa-history fa-fw"></i>Mark Status</span>
										<div class="dropdown-divider"></div>
										<a class="dropdown-item" href="javascript:;"
