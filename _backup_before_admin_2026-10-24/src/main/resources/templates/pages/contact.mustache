            </ul>
        </div>
    </div>
    <div class="inrbanrtxt contactbanr" style="background-image:url(assets/images/cart-banner.jpg);">
        <div class="container">
            <h1>Contact Us</h1>
        </div>
    </div>

    <div class="container">

        <div class="contactwrap">


            <div class="contactpage">

                <div class="col5">
                    <h3>Have a Query? Ask our Team</h3>
                    <p>Contact Artistick City to connect with us for any queries .</p>
                    {{#flash.success}}
<div class="alert alert-success alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.success}}</strong>
</div>
{{/flash.success}}

{{#flash.error}}
<div class="alert alert-danger alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.error}}</strong>
</div>
{{/flash.error}}

{{#flash.warning}}
<div class="alert alert-warning alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.warning}}</strong>
</div>
{{/flash.warning}}

{{#flash.info}}
<div class="alert alert-info alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.info}}</strong>
</div>
{{/flash.info}}

{{#hasErrors}}
<div class="alert alert-danger">
    <button type="button" class="close" data-dismiss="alert">×</button>
    Please check the form below for errors
</div>
{{/hasErrors}}
                    
                    <form class="form-sample" enctype="multipart/form-data" name="contactFrm" id="contactFrm" method="POST"
                        action="/contact">
                        <input type="hidden" name="_token" value="{{csrf}}">
                        <div class="ctForm">
                            <ul>
                                <li><input type="text" name="name" id="name" placeholder="Your Name"
                                        class="field">
                                    {{#errors.name}}
                                        <div class="alert alert-danger">{{errors.name}}</div>
                                    {{/errors.name}}
                                </li>
                                <li><input type="text" name="mobile_no" id="mobile_no" placeholder="Your Mobile No."
                                        class="field">
                                    {{#errors.mobile_no}}
                                        <div class="alert alert-danger">{{errors.mobile_no}}</div>
                                    {{/errors.mobile_no}}
                                </li>
                                <li><input type="email" name="email" id="email" placeholder="Your Email"
                                        class="field">
                                    {{#errors.email}}
                                        <div class="alert alert-danger">{{errors.email}}</div>
                                    {{/errors.email}}
                                    </li>
                                <li>
                                    <textarea name="message" id="message" placeholder="Describe Your Query" class="field"></textarea>
                                </li>
                                <li><input type="submit" value="Submit" class="btn"></li>
                            </ul>
                        </div>
                    </form>
