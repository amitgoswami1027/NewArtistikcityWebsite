                <h1>Dear, {{userData.name}}</h1>
                <p>Thank you for sign up for free courses, please find the login details:</p>
                <p>
                    Username: {{userData.email}}<br>
                    Password: {{userData.password}}
                </p>
                <p>Click <a href="{{loginUrl}}">here</a> to login!</p>
                <p>Thank you</p>
            </td>
        </tr>
    </table>

                        </td>
                    </tr>
                    <tr>
                        <td align="center" style=" padding: 35px; background-color: #e43e2b;" bgcolor="#e43e2b">
                            <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%"
