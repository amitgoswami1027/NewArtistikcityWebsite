# Copy to .env to change the defaults used by docker-compose.yml
DB_USERNAME=artistik
DB_PASSWORD=Artistik@2026
MYSQL_ROOT_PASSWORD=ArtistikRoot@2026
APP_PORT=8080
DB_PORT=3306
PAYMENT_TEST_MODE=true
# RAZORPAY_KEY=
# RAZORPAY_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# RAZORPAY_WEBHOOK_SECRET=
# PAYPAL_WEBHOOK_ID=
# COMMISSION_INR_PER_USD=84
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_TRUST_EMAIL=true
# APP_URL=https://artistikcity.com
# OTP_SECRET=change-me-to-a-long-random-string
# Signs newsletter unsubscribe links (optional; falls back to OTP_SECRET)
# NEWSLETTER_SECRET=another-long-random-string
# SMS_PROVIDER=log            # or twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# AUTH_COOKIE_SECURE=auto
# WEBAUTHN_RP_ID=artistikcity.com
# WEBAUTHN_ORIGINS=https://artistikcity.com
# ---- file storage (uploads, marketplace photos, generated PDFs) ----
# STORAGE_DRIVER=local        # or s3
# S3_BUCKET=artistikcity-uploads-123456789012
# AWS_REGION=ap-south-1
# S3_PREFIX=storage/          # public files; private ones (portfolios, certificates, paid downloads) go under private/
# S3_PUBLIC_BASE_URL=         # optional, e.g. https://cdn.artistikcity.com: new marketplace photos are saved as full URLs on it
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   # only on a laptop; on EC2 the server's IAM role is used
# SITE_PREVIEW_PASSWORD=     # set = site not open yet: every page asks for this password, search engines told not to index
# ---- payments: reconciliation, refunds, alerts (defaults in config/artistikcity.yml) ----
# PAYMENTS_RECONCILE_ENABLED=true          # every few minutes, ask Razorpay / PayPal about orders still waiting
# PAYMENTS_RECONCILE_EVERY_MINUTES=5
# PAYMENTS_RECONCILE_ALERT_AFTER_MINUTES=30
# PAYMENTS_TEST_BUYERS=true                # accounts marked "Test buyer" in Admin > People may simulate payments (false = nobody)
# ALERT_EMAIL=ops@artistikcity.com         # payment, refund, dispute and security alerts (empty = ADMIN_EMAIL)
# ---- live classes, ledger, security ----
# SEAT_HOLD_MINUTES=15                     # a seat is kept this long while a student pays
# COMMISSION_PERCENT=30                    # platform share of each artwork sale; the artist gets the rest
# PAYOUT_AFTER_DAYS=14                     # an artist's share becomes payable this many days after the sale
# PAY_STUDIO_ARTISTS=false                 # true = staff artists of studio listings are paid out too
# SECURITY_REFUSALS_BEFORE_REVOKE=5        # refused admin requests in SECURITY_REFUSAL_WINDOW_MINUTES that sign a staff session out
# SECURITY_REFUSAL_WINDOW_MINUTES=10
# UPLOADS_STRIP_METADATA=true              # remove GPS / camera data from uploaded photos
# UPLOADS_STRIP_EXISTING=false             # true for ONE start: clean photos uploaded before this existed
