<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ArtistikCity Marketplace</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Helvetica,Arial,sans-serif;color:#111;">
<table width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr><td align="center" style="padding:32px 12px;">
        <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">
            <tr><td style="background:#111;padding:24px 32px;color:#fff;font-size:13px;letter-spacing:2px;text-transform:uppercase;">ArtistikCity &middot; Marketplace</td></tr>
            <tr><td style="padding:32px;">
                <h1 style="margin:0 0 12px;font-size:22px;">{{#first}}A collector has a question{{/first}}{{^first}}New message from {{buyerName}}{{/first}}</h1>
                <p style="font-size:15px;line-height:1.6;"><strong>{{buyerName}}</strong> ({{buyerEmail}}) wrote about <strong>{{title}}</strong> by {{artist}}:</p>
                <blockquote style="margin:16px 0;padding:12px 16px;border-left:4px solid #e5156b;background:#fafafa;font-size:15px;line-height:1.6;white-space:pre-wrap;">{{message}}</blockquote>
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-top:12px;border-top:1px solid #eee;font-size:14px;">
                    <tr><td style="padding:8px 0;color:#666;">Artwork</td><td align="right" style="padding:8px 0;"><a href="{{artworkUrl}}" style="color:#111;">{{title}}</a></td></tr>
                    <tr><td style="padding:8px 0;color:#666;">Medium &middot; size</td><td align="right" style="padding:8px 0;">{{medium}} &middot; {{size}}</td></tr>
                    <tr><td style="padding:8px 0;color:#666;">Original price</td><td align="right" style="padding:8px 0;">&#8377;{{price}} ({{status}})</td></tr>
                    {{#context}}<tr><td style="padding:8px 0;color:#666;">Looking at</td><td align="right" style="padding:8px 0;">{{context}}</td></tr>{{/context}}
                </table>
                <p style="margin-top:20px;"><a href="{{replyUrl}}" style="display:inline-block;background:#111;color:#fff;text-decoration:none;font-weight:bold;padding:10px 18px;border-radius:999px;">Reply in the console</a></p>
            </td></tr>
            <tr><td style="padding:20px 32px;background:#fafafa;font-size:12px;color:#888;">Reply from the admin console so the collector sees it in the chat and gets an e-mail.</td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>
