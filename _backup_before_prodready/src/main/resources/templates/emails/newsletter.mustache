<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{subject}}</title>
    <style type="text/css">
        body { margin: 0 !important; padding: 0 !important; width: 100% !important; background: #f5f6fa; }
        img { border: 0; height: auto; max-width: 100%; }
        .nl-body h2 { font-size: 22px; line-height: 1.3; margin: 24px 0 8px; color: #0e1a3a; }
        .nl-body h3 { font-size: 18px; line-height: 1.35; margin: 20px 0 6px; color: #0e1a3a; }
        .nl-body p { margin: 0 0 14px; }
        .nl-body a { color: #e5156b; }
        .nl-body blockquote { margin: 16px 0; padding: 2px 0 2px 14px; border-left: 4px solid #e5156b; color: #3b4460; font-style: italic; }
        .nl-body img { display: block; margin: 14px 0; border-radius: 8px; }
        @media screen and (max-width: 600px) { .nl-wrap { padding: 20px 16px !important; } }
    </style>
</head>
<body style="margin:0;padding:0;background:#f5f6fa;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#f5f6fa;">{{preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f6fa;">
    <tr>
        <td align="center" style="padding:28px 12px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:14px;">
                <tr>
                    <td style="padding:24px 32px 0;" class="nl-wrap">
                        <a href="{{siteUrl}}" style="text-decoration:none;"><img src="{{siteUrl}}/assets/images/logo.png" alt="ArtistikCity" width="150" style="display:block;"></a>
                    </td>
                </tr>
                <tr>
                    <td class="nl-wrap nl-body" style="padding:20px 32px 28px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#27304a;">
                        {{{body}}}
                    </td>
                </tr>
            </table>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
                <tr>
                    <td style="padding:18px 32px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b7390;text-align:center;">
                        You are receiving this because you subscribed to ArtistikCity news.<br>
                        <a href="{{unsubscribeUrl}}" style="color:#6b7390;">Unsubscribe</a> · <a href="{{siteUrl}}" style="color:#6b7390;">artistikcity.com</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
