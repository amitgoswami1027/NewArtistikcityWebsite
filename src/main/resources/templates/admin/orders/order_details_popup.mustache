<div class="container-fluid">

    <div class="container">
        <!-- Title -->
        
        <div class="mb-3 d-flex justify-content-between">
            <div class="d-flex justify-content-between align-items-center py-3">
                <h2 class="h5 mb-0"><a href="#" class="text-muted"></a> Order #{{order.order_number}}</h2>
            </div>
            <div class="d-flex">
                <button class="btn btn-link p-0 me-3 d-none d-lg-block btn-icon-text"><i
                        class="bi bi-download"></i> <span class="text">Invoice</span></button>
                <div class="dropdown">
                    <button class="btn btn-link p-0 text-muted" type="button"
                        data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-pencil"></i>
                                Edit</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-printer"></i>
                                Print</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- Main content -->
        <div class="row">
            <div class="col-lg-8">
                <!-- Details -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="mb-3 d-flex justify-content-between">
                            <div>
                                <span class="me-3">{{#dateFmt}}M d, Y|{{order.created_at}}{{/dateFmt}}</span>
                                <span class="me-3">#{{order.order_number}}</span>
                                {{#when}}{{order.issue_certificate}}==1⟫
                                    <span class="p-2 md-2 badge rounded-pill bg-success text-white">COURSE COMPLETED</span>
                                ⟪else⟫
                                    <span class="p-2 md-2 badge rounded-pill bg-info text-white">COURSE IN PROGRESS</span>
                                {{/when}}
                                
                            </div>
                            <div class="d-flex"></div>
                        </div>
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="d-flex mb-2">
                                            <div class="flex-shrink-0">
                                                {{#when}}{{order.course.photos}}⟫
                                                    <img  class="img-fluid" src="/storage/uploads/courses/{{order.course.id}}/{{order.course.photos.0.photo_name}}" width="50">
                                                {{/when}}
                                            </div>
                                            <div class="p-2 flex-lg-grow-1 ms-3">
                                                <h5 class="mb-0"><a href="#" class="text-reset">{{order.course.title}}</a></h5>
                                                <p class="mb-0">Teacher: <a href="#" class="text-reset">{{order.course.teacher.name}}</a></p>
                                                <span class="small">{{#limit}}60|{{order.course.sub_title}}{{/limit}}</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>1</td>
                                    <td class="text-end">
                                        {{#when}}{{order.price_type}}==inr⟫
                                            &#8377;{{#money}}{{order.course.prices.0.price_inr}}{{/money}} 
                                        ⟪else⟫
                                            ${{#money}}{{order.course.prices.0.price_usd}}{{/money}} 
                                        {{/when}}
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2">Subtotal</td>
                                    <td class="text-end">
                                        {{#when}}{{order.price_type}}==inr⟫
                                            &#8377;{{#money}}{{order.course.prices.0.price_inr}}{{/money}} 
                                        ⟪else⟫
                                            ${{#money}}{{order.course.prices.0.price_usd}}{{/money}} 
                                        {{/when}}
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">Tax</td>
                                    <td class="text-end">--</td>
                                </tr>
                                <tr class="fw-bold">
                                    <td colspan="2">TOTAL</td>
                                    <td class="text-end">
                                        {{#when}}{{order.price_type}}==inr⟫
                                            &#8377;{{#money}}{{order.course.prices.0.price_inr}}{{/money}} 
                                        ⟪else⟫
                                            ${{#money}}{{order.course.prices.0.price_usd}}{{/money}} 
                                        {{/when}}
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <!-- Payment -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <h3 class="h6">Payment Method</h3>
                                <p>
                                    {{order.payment_option}} <br>
                                    {{#when}}{{order.price_type}}==inr⟫
                                        Total: &#8377;{{#money0}}{{order.price}}{{/money0}} 
                                    ⟪else⟫
                                        Total: ${{#money0}}{{order.price}}{{/money0}} 
                                    {{/when}}
                                    {{#when}}{{order.payment_status}}==1⟫
                                        <span class="p-2 md-2 badge bg-success rounded-pill text-white">PAID</span><br>
                                    ⟪else⟫
                                        <span class="p-2 md-2 badge bg-danger rounded-pill text-white">FAILED</span><br>
                                    {{/when}}
                                    <span class="me-3">Visa -1234</span>
                                </p>
                            </div>
                            <div class="col-lg-6">
                                <h3 class="h6">Billing address</h3>
                                <address>
                                    <strong>{{order.billing_name}}</strong><br>
                                    {{order.billing_address}}<br>
                                    {{order.billing_city}}, {{order.billing_state}} {{order.billing_zipcode}}<br>
                                    <abbr title="Phone">P:</abbr> {{order.user.phone}}
                                </address>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body ">
                        <h4>Student Information</h4>
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                {{#when}}{{order.user.profile_photo}}⟫
                                    <img class="img-fluid" src="/storage/uploads/students/{{order.user.id}}/{{order.user.profile_photo}}" width="50">
                                {{/when}} 
                            </div>
                            <div class="p-2 flex-lg-grow-1 ms-3">
                                <h5 class="mb-0"><a href="#" class="text-reset">{{order.user.name}}</a></h5>
                            </div>
                        </div>
                        <hr>
                        <h3 class="h6">Address</h3>
                        <address>
                            {{order.user.addresses.0.address}}<br>
                            {{order.user.addresses.0.city}}, {{order.user.addresses.0.state}} {{order.user.addresses.0.zipcode}}<br>
                            <abbr title="Phone">P:</abbr> {{order.user.phone}}
                        </address>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-body">
                        <h5>Actions</h5>
                        <ul>
                            <li><a href="">Mark Course Completed</a></li>
                            <li><a href="">Issue Certificate</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
