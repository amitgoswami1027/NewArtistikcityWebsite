<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Admin sign in · ArtistikCity</title>
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap">
    <link href="/css/font-awesome.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="/css/ac-theme.css">
</head>
<body style="margin:0">
<main class="ac adm-login">
    <div class="adm-login__card">
        <a href="/" class="adm-login__logo"><img src="/assets/images/logo.png" alt="ArtistikCity"></a>
        <span class="adm-login__tag">Admin</span>
        <h1>Sign in to the admin</h1>
        <p class="adm-login__lede">For the ArtistikCity team and instructors. Students sign in <a href="/login">here</a>.</p>
        {{#hasErrors}}
        <div class="adm-login__error" role="alert">
            <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
            <div>{{#errorList}}<p>{{.}}</p>{{/errorList}}</div>
        </div>
        {{/hasErrors}}
        <form method="POST" action="/admin/login" novalidate>
            <input type="hidden" name="_token" value="{{csrf}}">
            <label for="email">E-mail</label>
            <input id="email" type="email" name="email" value="{{old.email}}" autocomplete="username" required autofocus>
            <label for="password">Password</label>
            <div class="adm-login__pw">
                <input id="password" type="password" name="password" autocomplete="current-password" required>
                <button type="button" aria-label="Show password" onclick="var i=document.getElementById('password');var s=i.type==='password';i.type=s?'text':'password';this.setAttribute('aria-label',s?'Hide password':'Show password');this.firstElementChild.className=s?'fa fa-eye-slash':'fa fa-eye';"><i class="fa fa-eye" aria-hidden="true"></i></button>
            </div>
            <button type="submit" class="adm-login__submit">Sign in</button>
        </form>
        <p class="adm-login__help">Forgot your password? Ask a super admin to set a new one in <b>Instructor profiles</b>.</p>
    </div>
</main>
</body>
</html>
