</div>
{{/hasErrors}}
          
<form class="form-sample" enctype="multipart/form-data" name="courseFrm" id="courseFrm" method="POST" action="/admin/courses/store">
    <input type="hidden" name="_token" value="{{csrf}}">
    <input type="hidden" value="2" name="course_type_id" id="course_type_id" />
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Add Workshop</h4>
                <p class="card-description"> <a href="/admin/workshop">Manage Workshop</a> </p>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Title</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" name="title" id="title" placeholder="Title" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Age Group</label>
                            <div class="col-sm-9">
                                <select class="form-control1" name="age_group" id="age_group" style="width: 100%; color: #495057; border: 1px solid #ced4da; padding: 5px;">
                                    <option value="">Age Group</option>
                                    <option value="Sub-junior - 8 to 12 yrs">Sub-junior - 8 to 12 yrs</option>
                                    <option value="Junior - 12 to 15 yrs">Junior - 12 to 15 yrs</option>
                                    <option value="Adult - 16 yrs and above">Adult - 16 yrs and above</option>
                                </select>
                            </div>
                        </div>
                        
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Sub Title</label>
                            <div class="col-sm-9">
                                <textarea class="form-control" name="sub_title" id="sub_title" rows="10" placeholder="Sub Title"></textarea>
                            </div>
                        </div>
                        
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Genre</label>
                            <div class="col-sm-9">
                                <div class="row">
                                    
                                        {{#genres}}
                                        <div class="col-md-6">
                                        <div class="form-check">
                                            <label class="form-check-label" for="genre_{{-index}}">
                                                <input class="form-check-input" type="checkbox" name="genre[]" id="genre_{{-index}}" value="{{id}}"> {{name}}
                                                <i class="input-helper"></i>
                                            </label>
                                        </div>
                                    </div>
                                        {{/genres}}
                                    
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Start Date</label>
                            <div class="col-sm-9">
                                <input type="date" name="course_start_date" id="course_start_date" style="width: 100%; color: #495057; border: 1px solid #ced4da; padding: 5px;">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label" for="status">Status</label>
                            <div class="col-sm-9">
                                <select class="form-control1" name="status" id="status" style="width: 100%; color: #495057; border: 1px solid #ced4da; padding: 5px;">
                                    <option value="1" selected>Active</option>
                                    <option value="0">In-Active</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Medium</label>
                            <div class="col-sm-9">
                                <select class="form-control1" name="medium" id="medium" style="width: 100%; color: #495057; border: 1px solid #ced4da; padding: 5px;">
                                    <option value="">Select Medium</option>
                                    {{#mediums}}
                                        <option value="{{id}}">{{name}}</option>
                                    {{/mediums}}
                                </select>
                            </div>
                        </div>
                    </div>
