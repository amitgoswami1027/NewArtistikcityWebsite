    <script>
        tinymce.init({
            selector:'#introduction_details',
            width: 900,
            height: 300
        });
        tinymce.init({
            selector:'#summary_details',
            width: 900,
            height: 300
        });
        tinymce.init({
            selector:'#schedule_details',
            width: 900,
            height: 300
        });
        $(document).ready(function() {  
            $("#addHighlights").on("click", function() {  
                $("#more-highlights").append("<div class='form-group'><input type='text' name='course_highlights[]' class='form-control' placeholder='Course Highlights'></div>");  
            });  
            $("#removeHighlights").on("click", function() {  
                $("#more-highlights").children().last().remove();  
            });  

            $("#addCourseFor").on("click", function() {  
                $("#more-course-for").append("<div class='form-group'><input type='text' class='form-control' name='course_for[]' placeholder='Who is this course for?'></div>");  
            });  
            $("#removeCourseFor").on("click", function() {  
                $("#more-course-for").children().last().remove();  
            });
            
            $("#addCourseNotFor").on("click", function() {  
                $("#more-course-not-for").append("<div class='form-group'><input type='text' class='form-control' name='course_not_for[]' placeholder='Who is this course for?'></div>");  
            });  
            $("#removeCourseNotFor").on("click", function() {  
                $("#more-course-not-for").children().last().remove();  
            });

            $("#addProblemsSolved").on("click", function() {  
                $("#more-problems-solved").append("<div class='form-group'><input type='text' class='form-control' name='course_problems_solved[]' placeholder='What problems are solved with this course?'></div>");  
            });  
            $("#removeProblemsSolved").on("click", function() {  
                $("#more-problems-solved").children().last().remove();  
            });

            $("#addlearn").on("click", function() {  
                $("#more-learn").append("<div class='form-group'><input type='text' class='form-control' name='course_learn[]' placeholder='What will you learn?'></div>");  
            });  
            $("#removelearn").on("click", function() {  
                $("#more-learn").children().last().remove();  
            });

            $("#addDeliverables").on("click", function() {  
                $("#more-deliverables").append("<div class='form-group'><input type='text' class='form-control' name='course_deliverables[]' placeholder='Course Deliverables'></div>");  
            });  
            $("#removeDeliverables").on("click", function() {  
                $("#more-deliverables").children().last().remove();  
            });
	    
            $("#courseFrm").validate({
                rules: {
                    title: 'required'
                },
                messages: {
                    title: 'Title is required'
                },
            });
        });
    </script>

