<form class="form-sample" enctype="multipart/form-data" name="courseFrm" id="courseFrm" method="POST" action="/admin/courses/store">
    <input type="hidden" name="_token" value="{{csrf}}">
    <input type="hidden" value="1" name="course_type_id" id="course_type_id" />
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <div class="clearfix">
                    <h4 class="card-title float-left">Add Course</h4>
                    <a href="/admin/courses" class='btn btn-success float-right font-weight-bold'>Manage Course</a>
                </div>
                <hr class="my-4">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label"></label>
                            <div class="col-sm-9">
                                <div class="form-radio">
                                    <label class="form-check-label" for="gridRadiosIB">
                                        <input class="form-radio-flat" type="radio" name="course_based" id="gridRadiosIB" value="instructor_based"> Instructor Based Course
                                        <i class="input-helper"></i>
                                    </label>
                                </div>
                                <div class="form-radio">
                                    <label class="form-check-label" for="gridRadiosVB">
                                        <input class="form-radio-flat" type="radio" name="course_based" id="gridRadiosVB" value="video_course"> Video Course (Free Course)
                                        <i class="input-helper"></i>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label"></label>
                            <div class="col-sm-9">
                                <div class="form-check">
                                    <label class="form-check-label" for="gridRadiosFree">
                                        <input class="form-check-flat" type="checkbox" name="is_free_course" id="gridRadiosFree" value="1"> Is Free Course
                                        <i class="input-helper"></i>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <hr class="my-4">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Title</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" name="title" id="title" placeholder="Title" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Age Group</label>
                            <div class="col-sm-9">
                                <select class="form-control1" name="age_group" id="age_group" style="width: 100%; color: #495057; border: 1px solid #ced4da; padding: 5px;">
                                    <option value="">Age Group</option>
