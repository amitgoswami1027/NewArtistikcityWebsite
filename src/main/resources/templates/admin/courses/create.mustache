    <script>
        function readURL(input) {
            let imgWrap = "";
            let imgArray = [];
            if (input.files && input.files[0]) {
                let maxLength = $(this).attr('data_max_length');
                imgWrap = $('.upload_box').find('.upload_img_wrap');
                let files = input.files;
                let filesArr = Array.prototype.slice.call(files);
                console.log(filesArr);
                let iterator = 0;
                filesArr.forEach(function (f, index) {
                    if (!f.type.match('image.*')) {
                        return;
                    }
                    if (imgArray.length > maxLength) {
                        return false
                    } else {
                        let len = 0;
                        for (let i = 0; i < imgArray.length; i++) {
                            if (imgArray[i] !== undefined) {
                                len++;
                            }
                        }
                        if (len > maxLength) {
                            return false;
                        } else {
                            imgArray.push(f);

                            let reader = new FileReader();
                            reader.onload = function (e) {
                                console.log(f.name);
                                let html = "<div class='upload_img_box'><div data-number='" + $(".upload_img_close").length + "' data-file='" + f.name + "' class='img-bg'><img id='imageResult' src='" + e.target.result + "' alt='" + f.name + "' style='height: 100px;' class='img-fluid rounded shadow-sm mx-auto d-block' data-number='" + $(".upload_img_close").length + "' data-file='" + f.name + "' /><div class='upload_img_close'></div></div></div>";
                                imgWrap.append(html);
                                iterator++;
                            }
                            reader.readAsDataURL(f);
                        }
                    }
                });
            }
            $('body').on('click', ".upload_img_close", function (e) {
                let file = $(this).parent().data("file");
                for (let i = 0; i < imgArray.length; i++) {
                    if (imgArray[i].name === file) {
                        imgArray.splice(i, 1);
                        break;
                    }
                }
                $(this).parent().parent().remove();
            });
        }



        $(function () {
            $('#upload').on('change', function () {
                readURL(input);
            });
        });

        let input = document.getElementById( 'upload' );
        let infoArea = document.getElementById( 'upload-label' );

        input.addEventListener( 'change', showFileName );
        function showFileName( event ) {
            let input = event.srcElement;
            let fileName = input.files[0].name;
            infoArea.textContent = 'File name: ' + fileName;
