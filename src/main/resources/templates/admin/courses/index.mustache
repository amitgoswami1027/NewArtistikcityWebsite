                    form.submit();
                }
            });
        });

        $('#courseProjectModal').on('show.bs.modal', function (event) {
            let button = $(event.relatedTarget);
            let course_id = button.data('course');
            let modal = $(this)
            modal.find('.modal-title').text('Course Project (Course #' + course_id + ')');
            modal.find('.modal-body input#project_title').val('');
            modal.find('.modal-body input#project_description').val('');
            modal.find('.modal-body input#course_id').val(course_id);

            $.ajax({
                type: "GET",
                url: "/api/project/"+course_id,
                success: function (response) {
                    console.log(response);
                    let res = '';
                    $.each(response, function (index, value) {
                        res += '<tr>';
                        res += '<td>'+value.project_title+'</td>';
                        res += '<td><span class="bi bi-trash">Delete</span></td>';
                        res += '</tr>';

                        $('#project_list').html(res);
                    });
                },
                error: function(error) {
                    console.log(error)
                }
            });
        });

        $(document).ready(function () {
            $('#projectFrm').on('submit', function(e) {
                e.preventDefault();

                $.ajax({
                    type: "POST",
                    url: "/api/project/create",
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="_token"]').attr('content')
                    },
                    data: $('#projectFrm').serialize(),
                    dataType: 'json',
                    success: function (response) {
                        console.log(response)
                        $('#courseProjectModal').modal('hide')
                        // alert("data saved");
                    },
                    error: function(error) {
                        console.log(error)
                        // alert("Data not saved");
                    }
                });
            });
        });

        $('#courseReviewModal').on('show.bs.modal', function (event) {
            let button = $(event.relatedTarget);
            let course_id = button.data('course');
            let modal = $(this)
            modal.find('.modal-title').text('Course Review (Course #' + course_id + ')');
            modal.find('.modal-body input#module_title').val('');
            modal.find('.modal-body input#module_duration').val('');
            modal.find('.modal-body input#course_id').val(course_id);

            $.ajax({
                type: "GET",
                url: "/api/reviews/"+course_id,
                success: function (response) {
                    console.log(response);
                    let res = '';
                    $.each(response, function (index, value) {
                        res += '<tr>';
                        res += '<td>'+value.module_title+'</td>';
                        res += '<td>'+value.module_duration+'</td>';
                        res += '</tr>';

                        $('#review_list').html(res);
                    });
                },
                error: function(error) {
                    console.log(error)
                }
            });
        });

        $(document).ready(function () {
            $('#reviewFrm').on('submit', function(e) {
                e.preventDefault();

                $.ajax({
                    type: "POST",
                    url: "/api/review/create",
