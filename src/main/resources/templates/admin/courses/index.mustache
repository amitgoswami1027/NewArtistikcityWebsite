      <div class="main-panel">
        <div class="content-wrapper">
          {{#flash.success}}
<div class="alert alert-success alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.success}}</strong>
</div>
{{/flash.success}}

{{#flash.error}}
<div class="alert alert-danger alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.error}}</strong>
</div>
{{/flash.error}}

{{#flash.warning}}
<div class="alert alert-warning alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.warning}}</strong>
</div>
{{/flash.warning}}

{{#flash.info}}
<div class="alert alert-info alert-block">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>{{flash.info}}</strong>
</div>
{{/flash.info}}

{{#hasErrors}}
<div class="alert alert-danger">
    <button type="button" class="close" data-dismiss="alert">×</button>
    Please check the form below for errors
</div>
{{/hasErrors}}
          
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="clearfix">
                        <h4 class="card-title float-left">Manage Courses</h4>
                        <a href="/admin/courses/create" class='btn btn-success float-right font-weight-bold'>Add New Course</a>
                    </div>
                    <hr class="my-4">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            {{#when}}{{courses_count}}!=0⟫
                                <thead>
                                    <tr>
                                        <th> ID </th>
                                        <th> Photo </th>
                                        <th> Start Date </th>
                                        <th> Course Title </th>
                                        <th> Slug </th>
                                        <th> Medium </th>
                                        <th> Status </th>
                                        <th> Action </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#courses}}
                                        <tr>
                                            <td style="width: 5%" class="py-1"> {{id}} </td>
                                            <td style="width: 5%">
                                                {{#when}}{{photos}}⟫
                                                    <img src="/storage/uploads/courses/{{id}}/{{photos.0.photo_name}}" width="50">
                                                {{/when}}
                                            </td>
                                            <td style="width: 5%"> {{#dateFmt}}d/m/Y|{{course_start_date}}{{/dateFmt}} </td>
                                            <td style="width: 25%">
                                                {{#when}}{{is_free_course}}⟫
                                                    <span class="badge badge-warning">FREE</span>
                                                ⟪else⟫
                                                    <span class="badge badge-primary">PAID</span>
                                                {{/when}} 
                                                {{title}} 
                                            </td>
                                            <td style="width: 20%"> {{slug}} </td>
                                            <td style="width: 10%"> {{medium.name}} </td>
                                            <td style="width: 10%"> {{#when}}{{status}}⟫Active⟪else⟫InActive{{/when}} </td>
                                            <td style="width: 20%">
                                                <div class="row">
                                                    <a class="btn btn-primary btn-icon" href="/admin/courses/edit/{{id}}">Edit</a>&nbsp;
                                                    <form method="POST" action="/admin/courses/delete/{{id}}">
                                                        <input type="hidden" name="_token" value="{{csrf}}">
                                                        <input type="hidden" name="_method" value="DELETE">
                                                        <button type="submit" class="btn btn-danger btn-icon show_confirm">Delete</button>
                                                    </form>
                                                    
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="8">
                                                <a class="btn btn-outline-primary" data-toggle="modal" data-target="#courseModulesModal" data-course="{{id}}">Add Modules</a>&nbsp;
                                                <a class="btn btn-outline-primary" data-toggle="modal" data-target="#courseModulesLessonModal" data-course="{{id}}">Add Lessons</a>&nbsp;
                                                <a class="btn btn-outline-primary" data-toggle="modal" data-target="#courseProjectModal" data-course="{{id}}">Add Projects</a>&nbsp;
                                            </td>
                                        </tr>
                                    {{/courses}}
                                </tbody>
                            {{/when}}
                            {{#when}}{{courses_count}}==0⟫
                                <tbody>
                                    <tr>
                                        <td colspan="7">
                                            <center>
                                                <strong> No Active Course Found!</strong>
                                            </center>
                                        </td>
                                    </tr>
                                </tbody>
                            {{/when}}
                        </table>
                        {{{pagination}}}
                    </div>
                    <hr class="my-4">
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="courseProjectModal" tabindex="-1" role="dialog" aria-labelledby="courseProjectModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="max-width: 750px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="courseProjectModalLabel">Course Project</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form class="form-sample" name="projectFrm" id="projectFrm" method="POST">
                    <div class="modal-body">
                        <input type="hidden" name="course_id" id="course_id" />
