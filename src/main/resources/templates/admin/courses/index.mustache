                        console.log(response)
                        $('#courseReviewModal').modal('hide')
                        // alert("data saved");
                    },
                    error: function(error) {
                        console.log(error)
                        // alert("Data not saved");
                    }
                });
            });
        });

        $('#courseModulesModal').on('show.bs.modal', function (event) {
            let button = $(event.relatedTarget);
            let course_id = button.data('course');
            let modal = $(this)
            modal.find('.modal-title').text('Course Module (Course #' + course_id + ')');
            modal.find('.modal-body input#module_title').val('');
            modal.find('.modal-body input#module_duration').val('');
            modal.find('.modal-body input#course_id').val(course_id);

            $.ajax({
                type: "GET",
                url: "/api/modules/"+course_id,
                success: function (response) {
                    console.log(response);
                    let res = '';
                    $.each(response, function (index, value) {
                        res += '<tr>';
                        res += '<td>'+value.module_title+'</td>';
                        res += '<td>'+value.module_duration+'</td>';
                        res += '<td><span class="bi bi-trash"><a href="">Delete</a></span></td>';
                        res += '</tr>';

                        $('#modules_list').html(res);
                    });
                },
                error: function(error) {
                    console.log(error)
                }
            });
        });

        $(document).ready(function () {
            $('#moduleFrm').on('submit', function(e) {
                e.preventDefault();

                if($('.modal-body input#module_title').val() == ""){
                    alert('Please fill module title');
                    $('.modal-body input#module_title').focus();
                    return false;
                }

                if($('.modal-body input#module_duration').val() == ""){
                    alert('Please fill module duration');
                    $('.modal-body input#module_duration').focus();
                    return false;
                }

                $.ajax({
                    type: "POST",
                    url: "/api/modules/create",
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="_token"]').attr('content')
                    },
                    data: $('#moduleFrm').serialize(),
                    dataType: 'json',
                    success: function (response) {
                        console.log(response)
                        $('#courseModulesModal').modal('hide')
                        // alert("data saved");
                    },
                    error: function(error) {
                        console.log(error)
                        // alert("Data not saved");
                    }
                });
            });
        });

        function addTask(info){
            let course_id = $(info).attr('data-courseId');
            let module_id = $(info).attr('data-moduleId');
            let lesson_id = $(info).attr('data-lessonId');
            let lesson_title = $(info).attr('data-lessonTitle');
            $('#task_course_id').val(course_id);
            $('#task_module_id').val(module_id);
            $('#task_lesson_id').val(lesson_id);
            $('#courseTaskModalLabel').html('Add Task for Lesson: '+lesson_id+': '+lesson_title);
            $("#courseModulesLessonModal").modal('hide');
            $('#task_title').val('');
            $('#task_description').val('');
            $('#task_list').html('');
            $.ajax({
                type: "GET",
                url: "/api/modules/lessons/task/"+lesson_id,
                success: function (response) {
                    console.log(response);
                    let res = '';
                    $.each(response, function (index, value) {
                        res += '<tr>';
                        res += '<td>'+value.id+': '+value.task_title+'</td>';
                        res += '<td>'+value.status+'</td>';
                        res += '<td><span class="bi bi-trash"><a href="">Delete</a></span></span></td>';
                        res += '</tr>';

                        $('#task_list').html(res);
                    });
                },
                error: function(error) {
                    console.log(error)
                }
            });
            $("#courseLessonTaskModal").modal('show');
        }
        $('#courseModulesLessonModal').on('show.bs.modal', function (event) {
            let button = $(event.relatedTarget);
            let course_id = button.data('course');
            let modal = $(this)
            modal.find('.modal-title').text('Module Lesson (Course #' + course_id + ')');
            modal.find('.modal-body input#lesson_title').val('');
            tinymce.get('lesson_description').setContent('');
            modal.find('.modal-body input#course_id').val(course_id);

            $.ajax({
                type: "GET",
                url: "/api/modules/"+course_id,
                success: function (response) {
                    console.log(response);
                    let select = $('#module_id');
                    select.html('');
                    $.each(response, function (index, value) {
                        select.append('<option value="' + value.id + '">' + value.module_title + '</option>');
                    });
                },
                error: function(error) {
                    console.log(error)
                }
            });

            $('#lesson_list').html('');
            $.ajax({
                type: "GET",
                url: "/api/modules/lessons/"+course_id,
                success: function (response) {
                    console.log(response);
                    let res = '';
                    $.each(response, function (index, value) {
                        res += '<tr>';
                        res += '<td>'+value.lesson_title+'</td>';
                        res += '<td>'+value.status+'</td>';
                        res += '<td><span class="bi bi-trash"><a href="">Delete</a></span>&nbsp;|&nbsp;<span class="bi bi-trash"><a href="javascript:;" onclick="addTask(this)" data-lessonId="'+value.id+'" data-moduleId="'+value.module_id+'" data-courseId="'+value.course_id+'" data-lessonTitle="'+value.lesson_title+'" class="addtask">Add Task</a></span></td>';
                        res += '</tr>';

                        $('#lesson_list').html(res);
                    });
                },
                error: function(error) {
                    console.log(error)
                }
            });
        });

        $(document).ready(function () {
            $('#lessonFrm').on('submit', function(e) {
                e.preventDefault();
                var formData = new FormData();

                // let _token = $('meta[name="csrf-token"]').attr('content');
                let course_id = $(this).find("#course_id").val();
                let admin_id = $("input[name=admin_id]").val();
                let module_id = $(this).find("#module_id :selected").val();;
                let lesson_title = $("input[name=lesson_title]").val();
                if($('#lesson_pdf').prop('files')[0] == undefined){
                    var lesson_pdf = ""; 
                }else{
                    var lesson_pdf = $('#lesson_pdf').prop('files')[0]; 
                }
                let lesson_description = tinymce.get('lesson_description').getContent();
                
                formData.append('course_id', course_id);
                formData.append('admin_id', admin_id);
                formData.append('module_id', module_id);
                formData.append('lesson_title', lesson_title);
                formData.append('lesson_pdf', lesson_pdf);
                formData.append('lesson_description', lesson_description);
                
                $.ajax({
                    url: '/api/modules/lesson/create',
                    type: 'POST',
                    contentType: 'multipart/form-data',
                    cache: false,
                    contentType: false,
                    processData: false,
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="_token"]').attr('content')
                    },
                    data: formData,
                    success: (response) => {
                        // success
                        console.log(response);
                        $('#courseModulesLessonModal').modal('hide')
                    },
                    error: (response) => {
                        console.log(response);
                    }
                });
            });

            $('#taskFrm').on('submit', function(e) {
                e.preventDefault();

                $.ajax({
                    type: "POST",
                    url: "/api/modules/lesson/task/create",
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="_token"]').attr('content')
                    },
                    data: $('#taskFrm').serialize(),
                    dataType: 'json',
                    success: function (response) {
                        console.log(response.data)
                        let res = '';
                        let responseData = response.data;
                        // $.each(responseData, function (index, value) {
                        //     console.log(value);
                            res += '<tr>';
                            res += '<td>'+responseData.task_title+'</td>';
                            res += '<td>'+responseData.status+'</td>';
                            res += '<td><span class="bi bi-trash"><a href="">Delete</a></span></span></td>';
                            res += '</tr>';

                            $('#task_list').prepend(res);
                        // });

                        // alert("data saved");
                    },
                    error: function(error) {
                        console.log(error)
                        // alert("Data not saved");
                    }
                });
            });
        });
    </script>

