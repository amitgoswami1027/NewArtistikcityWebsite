<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="csrf-token" content="{{csrf}}">

        <title inertia>{{appName}}</title>

        <!-- Fonts -->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap">

        <!-- Styles -->
        <link rel="stylesheet" href="/css/app.css">
        <link rel="stylesheet" href="/css/style.css">
        <link href="/css/font-awesome.css" rel="stylesheet" type="text/css">
        <link href="/fonts/stylesheet.css" rel="stylesheet" type="text/css">
        <link href="/css/owl.carousel.css" rel="stylesheet" type="text/css">
        
        <!-- Scripts -->

            <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
        <link rel="stylesheet" href="/css/ac-theme.css">
    </head>
    <body class="font-sans antialiased">
        <!-- ac:header -->
<div class="ac">
<header class="dm-header">
    <div class="ac-wide dm-header__row">
        <a href="/" class="ac-logo" aria-label="ArtistikCity home"><img src="/assets/images/logo.png" alt="ArtistikCity" /></a>
        <nav class="dm-links dm-links--main" aria-label="Main">
            <a href="/how-it-works">How it works</a>
            <div class="dm-explore"><a href="/courses?type=all" style="display:inline-flex;align-items:center;gap:8px;padding:8px 12px;font-weight:600;font-size:15px;border-radius:999px;color:#111">Courses <i class="fa fa-angle-down"></i></a></div>
            <a href="/commission/step-1">Commission art</a>
            <a href="/marketplace">Marketplace</a>
            <a href="/studio-stories" class="is-accent">Studio Stories</a>
        </nav>
        <form class="dm-search" action="/courses" method="get" role="search">
            <i class="fa fa-search"></i>
            <input type="hidden" name="type" value="all">
            <input type="search" name="q" placeholder="Search courses…" aria-label="Search courses">
        </form>
        <nav class="dm-links dm-links--account" aria-label="Account">
            {{#auth.check}}
                <a href="/dashboard">My studio</a>
                <a href="javascript:void(0)" class="dm-btn dm-btn--line" onclick="document.getElementById('logout-form').submit();">Log out</a>
                <form id="logout-form" action="/logout" method="POST" style="display: none;"><input type="hidden" name="_token" value="{{csrf}}"></form>
            {{/auth.check}}
            {{#auth.guest}}
                <a href="/login">Log in</a>
                <a href="/join" class="dm-btn dm-btn--brand" style="margin-left:6px">Join for free</a>
            {{/auth.guest}}
        </nav>
        <button type="button" class="ac-burger" aria-label="Menu" onclick="var d=document.getElementById('ac-drawer');d.style.display=d.style.display==='block'?'none':'block';"><i class="fa fa-bars"></i></button>
    </div>
</header>
<div class="ac-drawer" id="ac-drawer" style="display:none;top:68px">
    <a href="/how-it-works">How it works</a>
    <a href="/courses?type=all">All courses</a>
    <a href="/courses?type=workshop">Workshops</a>
    <a href="/commission/step-1">Commission art</a>
    <a href="/marketplace">Marketplace</a>
    <a href="/studio-stories">Studio Stories</a>
    {{#auth.check}}<a href="/dashboard" class="dm-btn dm-btn--line dm-btn--block">My studio</a>{{/auth.check}}
    {{#auth.guest}}<a href="/join" class="dm-btn dm-btn--brand dm-btn--block">Join for free</a><a href="/login" class="dm-btn dm-btn--line dm-btn--block" style="margin-top:10px">Log in</a>{{/auth.guest}}
</div>
</div>
<!-- /ac:header -->

        


    <div class="breadCrumb">
        <div class="container">
            <ul>
                <li><a href="/">Home</a></li>
                <li>Checkout</li>
            </ul>
        </div>
    </div>

    <div class="checkoutHead">
        <div class="container">
            <h1>Checkout</h1>
        </div>
    </div>

    <div class="container">
        <div class="checkoutwrap">
            <div class="checkoutsteps">
                <div class="stepbox">
                    <div class="stephead">
                        <div class="stepname"><img src="/assets/images/step-1.png" alt=""> Your ar logged in as:</div>
                        <div class="loginas"><img src="/assets/images/user1.png" alt=""> {{auth.user.name}}</div>
                        <div class="userlogout">
                            <button onclick="$('#logout-form').submit();"><img src="/assets/images/logout-icon.png" alt=""> Logout</button>
                            <form id="logout-form" action="/logout" method="POST" style="display: none;">
                                <input type="hidden" name="_token" value="{{csrf}}">
                            </form>
                        </div>
                    </div>
                </div>

                <div class="stepbox">
                    <div class="stephead">
                        <div class="stepname"><img src="/assets/images/step-2.png" alt=""> Billing Details</div>
                        <div class="blngAdrs"><p>{{auth.user.name}}, {{auth.user.email}}</p></div>
                        <div class="userlogout"><button id="editBillingInfo"><img src="/assets/images/edit-icon.png" alt=""> Edit</button></div>
                    </div>
                    <div class="stepcontent stepcompleted">
                        <div class="billingform">
                            <form method="post" action="/checkout/billing/{{order.id}}">
                                <input type="hidden" name="_token" value="{{csrf}}">
                                <input type="hidden" name="_method" value="PATCH">
                                <ul>
                                    <li><input type="text" class="field" placeholder="Name" name="billing_name" id="billing_name" value="{{auth.user.name}}"></li>
                                    <li><input type="email" class="field" placeholder="Email" name="billing_email" value="{{auth.user.email}}" readonly></li>
                                    <li class="w100"><input type="text" class="field" placeholder="Address" name="billing_address" id="billing_address" value="{{order.billing_address}}"></li>
                                    <li><input type="text" class="field" placeholder="City" name="billing_city" id="billing_city" value="{{order.billing_city}}"></li>
                                    <li><input type="text" class="field" placeholder="State" name="billing_state" id="billing_state" value="{{order.billing_state}}"></li>
                                    <li>
                                        <select class="field" name="billing_country" id="billing_country">
                                            <option value="">Country</option>
                                            <option value="india" {{#countryIndia}}selected{{/countryIndia}}>India</option>
                                            <option value="usa" {{#countryUsa}}selected{{/countryUsa}}>USA</option>
                                        </select>
                                    </li>
                                    <li><input type="text" class="field" placeholder="Zip Code / Postal Code" name="billing_zipcode" id="billing_zipcode" value="{{order.billing_zipcode}}"></li>
                                    <li class="w100"><input type="submit" class="btn" value="Continue"></li>
                                </ul>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="stepbox">
                    <div class="stephead">
                        <div class="stepname"><img src="/assets/images/step-3.png" alt=""> Payment Option</div>
                    </div>
                    <div class="stepcontent">
                        <div class="paymentoption">
                            <p>Choose your payment option</p>
                            <form action="/checkout/payment" method="POST">
                                <input type="hidden" name="order_id" value="{{order.id}}">
                                <input type="hidden" name="_token" value="{{csrf}}">
                                {{#razorpayKey}}
                                <script src="https://checkout.razorpay.com/v1/checkout.js"
                                        data-key="{{razorpayKey}}"
                                        data-amount="{{course.price_inr_paise}}"
                                        data-buttontext="UPI / Net Banking / Credit Card / Debit Card"
                                        data-name="{{course.title}}"
                                        data-description="Purchase of course: {{course.title}}"
                                        data-image=""
                                        data-prefill.contact="565656567"
                                        data-prefill.name="{{auth.user.name}}"
                                        data-prefill.email="{{auth.user.email}}"
                                        data-theme.color="#ff7529">
                                </script>
                                {{/razorpayKey}}
                                {{^razorpayKey}}
                                {{#paymentTestMode}}
                                <input type="hidden" name="razorpay_payment_id" value="test_payment">
                                <p><small>Razorpay keys are not configured (RAZORPAY_KEY). Test mode is enabled, so you can complete a simulated payment.</small></p>
                                <input type="submit" class="btn" value="Complete test payment (INR {{course.price_inr_fmt}})">
                                {{/paymentTestMode}}
                                {{^paymentTestMode}}
                                <p><small>Online card/UPI payments are not configured yet (set RAZORPAY_KEY and RAZORPAY_SECRET).</small></p>
                                {{/paymentTestMode}}
                                {{/razorpayKey}}
                            </form>
                        </div>
                        <div class="paymentoption">
                            <div class="panel panel-default" style="margin-top: 60px;">

                                {{#flash.success}}
                                    <div class="custom-alerts alert alert-success fade in">
                                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true"></button>
                                        {{flash.success}}
                                    </div>
                                    
                                {{/flash.success}}
            
                                {{#flash.error}}
                                    <div class="custom-alerts alert alert-danger fade in">
                                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true"></button>
                                        {{flash.error}}
                                    </div>
                                    
                                {{/flash.error}}
                                <div class="panel-heading"><b>Paywith Paypal</b></div>
                                <div class="panel-body">
                                    <form class="form-horizontal" method="POST" id="payment-form" role="form" action="/paypal">
                                        <input type="hidden" name="_token" value="{{csrf}}">
                                        <input type="hidden" name="order_id" value="{{order.id}}">
                                        
            
                                        <div class="form-group">
                                            <div class="col-md-6 col-md-offset-4">
                                                <button type="submit" class="btn btn-primary">
                                                    Pay USD {{course.price_usd}} via Paypal
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            
                        </div>
                    </div>
                </div>
            </div>

            <div class="checkoutsidebar">
                <div class="widget">
                    <h3>You are Purchasing</h3>
                    <div class="pd30">
                        <img src="{{course.photo_url}}">
                        <h4>{{course.title}}</h4>
                        <p>{{course.duration}} / {{course.time_required}}</p>
                        <strong class="price">₹{{course.price_inr_fmt}} </strong>
                        <h6>(Including all taxes)</h6>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="section newsLtr" style="background-image:url(/assets/images/newsletter-Bg.jpg);">
    <div class="container">
        <h2>Sign Up Our Newsletter</h2>
        <p>Subscribe our newsletter to receive the latest news and exclusive offers every week.</p>
        <div class="sgForm">
            <form>
                <input type="email"  placeholder="Email Address">
                <input type="submit" class="btn" value="Subscribe" name="submit">
            </form>
        </div>
    </div>
</section>




        <!-- Footer Section Start -->
<!-- ac:footer -->
<div class="ac">
<footer class="dm-footer">
    <div class="ac-wide">
        <div class="dm-footer__grid">
            <div class="dm-footer__brand">
                <a href="/"><img src="/assets/images/footerlogo.png" alt="ArtistikCity" /></a>
                <p style="max-width:320px">Online art courses taught live by a working artist. Learn to draw and paint at your own pace, in any medium, at any age.</p>
                <div class="ac-social">
                    <a href="https://www.facebook.com/StudioVaishaliArts/" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                    <a href="https://www.instagram.com/artistikcity/" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                    <a href="https://www.youtube.com/@artistikcityYT" target="_blank" rel="noopener" aria-label="YouTube"><i class="fa fa-youtube-play"></i></a>
                    <a href="https://in.linkedin.com/in/vaishali-jetly-goswami-4b5874233" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa fa-linkedin"></i></a>
                </div>
            </div>
            <div><h6>Courses</h6><ul id="latestCourses"><li></li></ul><ul><li><a href="/courses?type=course">All courses</a></li></ul></div>
            <div><h6>Workshops</h6><ul id="latestWorkshop"><li></li></ul><ul><li><a href="/courses?type=workshop">All workshops</a></li></ul></div>
            <div><h6>ArtistikCity</h6><ul>
                <li><a href="/commission/step-1">Artist Commission Portal</a></li>
                <li><a href="/artistikcity-vision">Our vision</a></li>
                <li><a href="/how-it-works">How it works</a></li>
                <li><a href="/instructor">Our instructor</a></li>
                <li><a href="/marketplace">Art marketplace</a></li>
                <li><a href="/studio-stories">Studio Stories</a></li>
                <li><a href="https://studiovaishaliarts.com/" target="_blank" rel="noopener">Studio Vaishali Arts</a></li>
            </ul></div>
            <div><h6>Support</h6><ul>
                <li><a href="/faq">FAQ</a></li>
                <li><a href="/customer-support">Help centre</a></li>
                <li><a href="/contact">Contact us</a></li>
                <li><a href="/join">Join for free</a></li>
            </ul></div>
        </div>
        <div class="dm-footer__bottom">
            <span>&copy; {{year}} ArtistikCity. All rights reserved.</span>
            <nav><a href="/terms-conditions">Terms of use</a><a href="/privacy-policy">Privacy policy</a><a href="/contact">Contact</a></nav>
        </div>
    </div>
</footer>
</div>
<!-- /ac:footer -->
<!-- Footer Section End -->


        <script src="/js/jquery.min.js" type="text/javascript"></script>
        <script src="/js/owl.carousel.js" type="text/javascript"></script>
        <script src="/js/custom.js" type="text/javascript"></script>

        
   <script>
       $('#editBillingInfo').click(function(){
           $('.stepcompleted').show();
       });
   </script> 

<script>
$(document).ready(function() { 
    $.ajax({
        headers: {
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
        },
        url : "/api/get_footer_data",
        type : 'GET',
        dataType : 'json',
        success : function(result){
            let latestCourses = result.latestCourses;
            let latestWorkshop = result.latestWorkshop;
            var latestCoursesHtml = '';
            var latestWorkshopHtml = '';
            $.each( latestCourses, function( i, val ) {
                latestCoursesHtml += '<li><a href="/course/'+val.slug+'">'+val.title+'</a></li>';
            });
            $.each( latestWorkshop, function( i, value ) {
                latestWorkshopHtml += '<li><a href="/course/'+value.slug+'">'+value.title+'</a></li>';
            });
            // console.log(latestCoursesHtml);
            $('#latestCourses').html(latestCoursesHtml);
            $('#latestWorkshop').html(latestWorkshopHtml);
            // console.log("===== " + result + " =====");

        }
    });
});
</script>

    </body>
</html>
