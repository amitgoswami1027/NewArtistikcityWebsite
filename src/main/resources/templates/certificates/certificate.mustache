                    </div>

                    <div class="" style="width: 100%;">
                        <div class="" style="margin-right: -15px; margin-left: -15px;">
                            <div class="" style="width: 16.66666667%;">
                                <!-- LEAVE EMPTY -->
                            </div>
                            <div class="pm-course-title">
                                <span class="pm-earned-text cursive">while completing the training course
                                    entitled</span>
                            </div>
                            <div class="" style="width: 16.66666667%;">
                                <!-- LEAVE EMPTY -->
                            </div>
                        </div>
                    </div>

                    <div class="" style="width: 100%;">
                        <div class="" style="margin-right: -15px; margin-left: -15px;">
                            <div class="" style="width: 16.66666667%;">
