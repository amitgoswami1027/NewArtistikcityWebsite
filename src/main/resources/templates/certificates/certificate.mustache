                <div class="col-xs-12">
                    <div class="row">
                        <div class="pm-certificate-footer">
                            <div class="pm-certified" style="width: 33.33333333%; text-align: center; float: left;">
                                <span class="pm-credits-text block sans"><strong>ArtistikCity</strong></span>
                                <span class="pm-empty-space block underline">{{signature}}</span>
                                <span class="bold block">Art Learning for Anyone, Anywhere</span>
                            </div>

                            <div class="pm-certified" style="width: 33.33333333%; text-align: center; float: right;">
                                <span class="pm-credits-text block sans"><strong>Completed Date</strong></span>
                                <span class="pm-empty-space block underline">{{certificate_date}}</span>
                                <span class="bold block">Certificate # {{certificate_number}}</span>
