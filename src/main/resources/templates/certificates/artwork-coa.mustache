<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Certificate of Authenticity · {{title}}</title>
    <meta name="robots" content="noindex">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root { --ink: #1d1a16; --muted: #6d655b; --line: #d9cfbf; --gold: #a07c3b; --paper: #fbf8f2; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #e9e4da; color: var(--ink); font-family: Inter, system-ui, sans-serif; }
        .bar { max-width: 900px; margin: 20px auto 0; padding: 0 16px; display: flex; gap: 10px; justify-content: flex-end; }
        .bar a, .bar button { font: 500 14px Inter, sans-serif; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line);
            background: #fff; color: var(--ink); text-decoration: none; cursor: pointer; }
        .bar button { background: var(--ink); color: #fff; border-color: var(--ink); }
        .sheet { max-width: 900px; margin: 16px auto 40px; background: var(--paper); padding: 56px 64px; position: relative;
            box-shadow: 0 20px 50px rgba(40, 30, 10, .16); }
        .sheet::before { content: ""; position: absolute; inset: 14px; border: 1px solid var(--gold); pointer-events: none; }
        .sheet::after { content: ""; position: absolute; inset: 20px; border: 3px double var(--line); pointer-events: none; }
        .brand { text-align: center; letter-spacing: .32em; font-size: 12px; color: var(--muted); text-transform: uppercase; }
        h1 { font-family: "Cormorant Garamond", serif; font-weight: 600; font-size: 44px; text-align: center; margin: 10px 0 4px; }
        .sub { text-align: center; color: var(--muted); font-size: 14px; margin-bottom: 36px; }
        .grid { display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: start; }
        .art { background: #fff; padding: 12px; box-shadow: 0 8px 22px rgba(0, 0, 0, .12); }
        .art img { width: 100%; display: block; }
        .art-title { font-family: "Cormorant Garamond", serif; font-style: italic; font-size: 30px; margin: 0 0 4px; }
        .by { color: var(--muted); margin-bottom: 22px; }
        dl { display: grid; grid-template-columns: 150px 1fr; margin: 0; row-gap: 10px; font-size: 14px; }
        dt { color: var(--muted); }
        dd { margin: 0; font-weight: 500; }
        .statement { margin: 36px 0 0; font-family: "Cormorant Garamond", serif; font-size: 19px; line-height: 1.5; text-align: center; }
        .sign { display: flex; justify-content: space-between; margin-top: 48px; gap: 40px; }
        .sign div { flex: 1; border-top: 1px solid var(--ink); padding-top: 8px; font-size: 13px; color: var(--muted); }
        .sign strong { display: block; color: var(--ink); font-family: "Cormorant Garamond", serif; font-size: 20px; font-weight: 600; }
        .no { text-align: center; margin-top: 30px; font-size: 12px; letter-spacing: .14em; color: var(--muted); }
        @media (max-width: 720px) { .sheet { padding: 40px 28px; } .grid { grid-template-columns: 1fr; } h1 { font-size: 32px; } dl { grid-template-columns: 120px 1fr; } }
        @media print { body { background: #fff; } .bar { display: none; } .sheet { box-shadow: none; margin: 0 auto; } }
    </style>
</head>
<body>
<div class="bar">
    <a href="/user/orders">Back to your orders</a>
    <button type="button" onclick="window.print()">Print / save as PDF</button>
</div>
<main class="sheet">
    <div class="brand">ArtistikCity</div>
    <h1>Certificate of Authenticity</h1>
    <div class="sub">{{#original}}Original artwork{{/original}}{{^original}}Numbered limited edition{{/original}}</div>
    <div class="grid">
        <div class="art">{{#image}}<img src="{{image}}" alt="{{title}}">{{/image}}</div>
        <div>
            <p class="art-title">{{title}}</p>
            <div class="by">by {{artist}}</div>
            <dl>
                <dt>Edition</dt><dd>{{variant}}</dd>
                {{#edition}}<dt>Edition number</dt><dd>{{edition}}</dd>{{/edition}}
                {{#medium}}<dt>Medium</dt><dd>{{medium}}{{#surface}} on {{surface}}{{/surface}}</dd>{{/medium}}
                <dt>Original size</dt><dd>{{size}}</dd>
                {{#year}}<dt>Year</dt><dd>{{year}}</dd>{{/year}}
                <dt>Collector</dt><dd>{{collector}}</dd>
                <dt>Acquired</dt><dd>{{date}}</dd>
                <dt>Order</dt><dd>{{orderId}}</dd>
            </dl>
        </div>
    </div>
    <p class="statement">
        {{#original}}This certifies that the artwork described above is an original, one-of-one work by {{artist}},
        sold through ArtistikCity to the collector named here.{{/original}}
        {{^original}}This certifies that the print described above is an authorised, numbered edition of the original
        work by {{artist}}, produced and sold through ArtistikCity.{{/original}}
    </p>
    <div class="sign">
        <div><strong>{{artist}}</strong>Artist</div>
        <div><strong>ArtistikCity</strong>Issued by the marketplace</div>
    </div>
    <div class="no">CERTIFICATE NO. {{certificateNo}}</div>
</main>
</body>
</html>
