<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ArtistikCity Marketplace</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Helvetica,Arial,sans-serif;color:#111;">
<table width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr><td align="center" style="padding:32px 12px;">
        <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">
            <tr><td style="background:#111;padding:24px 32px;color:#fff;font-size:13px;letter-spacing:2px;text-transform:uppercase;">ArtistikCity &middot; Offers</td></tr>
            <tr><td style="padding:32px;">
                <h1 style="margin:0 0 12px;font-size:22px;">{{heading}}</h1>
                <p style="font-size:15px;line-height:1.6;">Hi {{name}},</p>
                {{#lines}}<p style="font-size:15px;line-height:1.6;margin:0 0 10px;">{{.}}</p>{{/lines}}
                <table cellpadding="0" cellspacing="0" role="presentation" style="margin:16px 0;width:100%;border:1px solid #eee;border-radius:10px;">
                    <tr><td style="padding:12px 16px;font-size:14px;color:#555;">Artwork</td><td style="padding:12px 16px;font-size:14px;font-weight:bold;text-align:right;">{{title}}</td></tr>
                    <tr><td style="padding:12px 16px;font-size:14px;color:#555;border-top:1px solid #eee;">Listed price</td><td style="padding:12px 16px;font-size:14px;text-align:right;border-top:1px solid #eee;">&#8377;{{listPrice}}</td></tr>
                    {{#amount}}<tr><td style="padding:12px 16px;font-size:14px;color:#555;border-top:1px solid #eee;">{{amountLabel}}</td><td style="padding:12px 16px;font-size:16px;font-weight:bold;text-align:right;border-top:1px solid #eee;color:#9c0d48;">&#8377;{{amount}}</td></tr>{{/amount}}
                </table>
                {{#note}}<blockquote style="margin:16px 0;padding:12px 16px;border-left:4px solid #9c0d48;background:#fafafa;font-size:15px;line-height:1.6;white-space:pre-wrap;">{{note}}</blockquote>{{/note}}
                {{#url}}<p style="margin-top:20px;"><a href="{{url}}" style="display:inline-block;background:#9c0d48;color:#fff;text-decoration:none;font-weight:bold;padding:10px 18px;border-radius:999px;">{{button}}</a></p>{{/url}}
            </td></tr>
            <tr><td style="padding:20px 32px;background:#fafafa;font-size:12px;color:#888;">{{footnote}}</td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>
