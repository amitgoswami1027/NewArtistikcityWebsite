<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ArtistikCity Marketplace</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Helvetica,Arial,sans-serif;color:#111;">
<table width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr><td align="center" style="padding:32px 12px;">
        <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">
            <tr><td style="background:#111;padding:24px 32px;color:#fff;font-size:13px;letter-spacing:2px;text-transform:uppercase;">ArtistikCity &middot; Marketplace</td></tr>
            <tr><td style="padding:32px;">
                {{#refund}}
                <h1 style="margin:0 0 12px;font-size:24px;">About your order {{order_id}}</h1>
                <p style="font-size:15px;line-height:1.6;">Your payment for <strong>{{title}}</strong> reached us after your 15-minute hold had ended, and the piece had already gone to another collector. We're sorry. We will refund the full amount ({{currency}} {{amount}}) to your original payment method within 5&ndash;7 working days.</p>
                {{/refund}}
                {{^refund}}
                <h1 style="margin:0 0 12px;font-size:24px;">It's yours: {{title}}</h1>
                <p style="font-size:15px;line-height:1.6;">Thank you, {{buyer_name}}. Your payment is confirmed and this 1-of-1 original by <strong>{{artist_name}}</strong> is now reserved for you permanently. We'll pack it with care and email you the courier tracking number when it ships.</p>
                {{/refund}}
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-top:20px;border-top:1px solid #eee;font-size:14px;">
                    <tr><td style="padding:10px 0;color:#666;">Order</td><td align="right" style="padding:10px 0;font-family:monospace;">{{order_id}}</td></tr>
                    <tr><td style="padding:10px 0;color:#666;">Artwork</td><td align="right" style="padding:10px 0;">{{title}} &middot; {{medium}} on {{surface}}</td></tr>
                    <tr><td style="padding:10px 0;color:#666;">Size</td><td align="right" style="padding:10px 0;">{{height_inches}} &times; {{width_inches}} in</td></tr>
                    <tr><td style="padding:10px 0;color:#666;">Paid</td><td align="right" style="padding:10px 0;font-weight:bold;">{{currency}} {{amount}}</td></tr>
                    <tr><td style="padding:10px 0;color:#666;">Ship to</td><td align="right" style="padding:10px 0;">{{address_line1}}, {{city}} {{postal_code}}, {{country}}</td></tr>
                </table>
                {{#has_certificate}}<p style="font-size:13px;color:#666;margin-top:20px;">A signed certificate of authenticity travels with the artwork.</p>{{/has_certificate}}
            </td></tr>
            <tr><td style="padding:20px 32px;background:#fafafa;font-size:12px;color:#888;">Questions? Reply to this email and quote your order number.</td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>
