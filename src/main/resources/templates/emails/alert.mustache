<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
</head>
<body style="margin:0;padding:24px;background:#F8F9FA;font-family:Arial,Helvetica,sans-serif;color:#2C3E50;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #ECF0F1;border-radius:8px;">
    <tr><td style="padding:20px 24px;border-bottom:3px solid #9C0D48;">
        <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#4A5866;">ArtistikCity alert</div>
        <h1 style="margin:6px 0 0;font-size:20px;line-height:1.3;color:#2C3E50;">{{title}}</h1>
    </td></tr>
    <tr><td style="padding:20px 24px;font-size:15px;line-height:1.6;">
        {{#lines}}<p style="margin:0 0 10px;">{{.}}</p>{{/lines}}
        {{#url}}<p style="margin:18px 0 0;"><a href="{{url}}" style="display:inline-block;background:#9C0D48;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;">Open in the admin console</a></p>{{/url}}
    </td></tr>
    <tr><td style="padding:14px 24px;font-size:12px;color:#4A5866;border-top:1px solid #ECF0F1;">Sent automatically at {{at}}. Change who receives alerts with ALERT_EMAIL (config/artistikcity.yml, app.alerts.email).</td></tr>
</table>
</body>
</html>
