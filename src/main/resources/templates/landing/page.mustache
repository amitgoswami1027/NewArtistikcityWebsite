{{#marketing.leadCapture}}
<section class="lp-sec lp-bg--plain lp-lead" aria-labelledby="lp-lead-h">
  <div class="lp-wrap lp-narrow">
    <h2 id="lp-lead-h" class="lp-lead__h">Not ready to enrol yet?</h2>
    <p>Join the ArtistikCity newsletter for new batches, workshops and offers. No spam; unsubscribe with one click.</p>
    <form class="lp-lead__form" id="lp-lead" novalidate>
      <div class="lp-lead__row">
        <label for="lp-lead-email" class="sr">E-mail address</label>
        <input id="lp-lead-email" type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required maxlength="255">
        <input type="text" name="website" class="lp-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit" class="lp-btn">Subscribe</button>
      </div>
      <label class="lp-lead__ok"><input type="checkbox" name="consent" required> I agree to receive the ArtistikCity newsletter by e-mail.</label>
      <p class="lp-lead__msg" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
