><filter id="wp"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2"/><feColorMatrix values="0 0 0 0 0.95 0 0 0 0 0.93 0 0 0 0 0.88 0 0 0 0.35 0"/></filter></defs><rect width="320" height="200" fill="#fbf8f1"/><g filter="url(#wc)" opacity=".85"><circle cx="110" cy="90" r="52" fill="#f28ab2"/><circle cx="170" cy="110" r="48" fill="#8ecae6"/><circle cx="220" cy="80" r="40" fill="#ffd166"/><path d="M40 170c60-20 180-24 250-4" stroke="#90be6d" stroke-width="18" fill="none"/></g><rect width="320" height="200" filter="url(#wp)"/></svg>{{/is_WATERCOLOR}}{{#is_CHARCOAL}}<svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><defs><filter id="ch"><feTurbulence type="fractalNoise" baseFrequency="1.2" numOctaves="2"/><feColorMatrix values="0 0 0 0 0.9 0 0 0 0 0.9 0 0 0 0 0.88 0 0 0 0.5 0"/></filter></defs><rect width="320" height="200" fill="#efece6"/><g stroke="#1b1b1b" fill="none" stroke-linecap="round"><path d="M70 160c20-70 60-110 110-112s80 40 84 112" stroke-width="5"/><path d="M100 150c16-50 40-78 78-80" stroke-width="2" opacity=".7"/><path d="M120 72c10-22 30-34 56-30" stroke-width="3"/><path d="M170 60l22 -18" stroke-width="1.5" opacity=".55"/><path d="M175 65l22 -18" stroke-width="1.5" opacity=".55"/><path d="M180 70l22 -18" stroke-width="1.5" opacity=".55"/><path d="M185 75l22 -18" stroke-width="1.5" opacity=".55"/><path d="M190 80l22 -18" stroke-width="1.5" opacity=".55"/><path d="M195 85l22 -18" stroke-width="1.5" opacity=".55"/><path d="M200 90l22 -18" stroke-width="1.5" opacity=".55"/><path d="M205 95l22 -18" stroke-width="1.5" opacity=".55"/><path d="M210 100l22 -18" stroke-width="1.5" opacity=".55"/><path d="M215 105l22 -18" stroke-width="1.5" opacity=".55"/><path d="M220 110l22 -18" stroke-width="1.5" opacity=".55"/><path d="M225 115l22 -18" stroke-width="1.5" opacity=".55"/><path d="M230 120l22 -18" stroke-width="1.5" opacity=".55"/><path d="M235 125l22 -18" stroke-width="1.5" opacity=".55"/><path d="M240 130l22 -18" stroke-width="1.5" opacity=".55"/><path d="M245 135l22 -18" stroke-width="1.5" opacity=".55"/><circle cx="176" cy="96" r="10" fill="#1b1b1b"/></g><rect width="320" height="200" filter="url(#ch)"/></svg>{{/is_CHARCOAL}}</span>
            <span class="lp-theme__t"><b>{{title}}</b><small>{{blurb}}</small></span>
            <span class="lp-theme__on" aria-hidden="true">Selected</span>
          </label>
          {{/themes}}
        </div>
      </fieldset>
      <div class="lp-cform__bar">
        <p class="lp-cform__msg" role="status" aria-live="polite"></p>
        <button type="submit" class="lp-btn lp-btn--lg" data-cta="commission-next">Next: choose delivery &amp; size <svg aria-hidden="true"><use href="#i-arrow"/></svg></button>
      </div>
      <p class="lp-fine">Your choices stay in this browser while you go through the steps. You see the full price before you pay, and you pay only at checkout.</p>
    </form>
  </div>
{{/is_commission_form}}

{{#is_commission_pricing}}
  <div class="lp-wrap lp-narrow">
    {{#kicker}}<p class="lp-kicker">{{kicker}}</p>{{/kicker}}
    <h2 id="{{id}}-h" class="lp-h2">{{heading}}</h2>
